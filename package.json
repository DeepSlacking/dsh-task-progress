{
  "name": "dsh-task-progress",
  "version": "0.5.4",
  "type": "module",
  "description": "Shows the running task's progress with a node rail in the session and a progress ring on its sidebar row, self-assessed by the session's own model at nodes.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node --test test/progress.test.mjs test/steps.test.mjs test/client.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "author": "DeepSlacking",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepSlacking/dsh-task-progress.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "progress",
    "task"
  ]
}
